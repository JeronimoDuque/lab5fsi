# MongoDB Atlas Connection URL
# Formato: mongodb+srv://<usuario>:<password>@<cluster-url>/fastfoodudea?retryWrites=true&w=majority&appName=FastFoodUdeA
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.mongodb.net/fastfoodudea?retryWrites=true&w=majority&appName=FastFoodUdeA

# JWT Secret for Authentication
JWT_SECRET=super_secret_fastfoodudea_key_2026_jwt_auth_token

# Server Port
PORT=3000

# Public Socket URL for Frontend
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# PayPal Sandbox Configuration
NEXT_PUBLIC_PAYPAL_CLIENT_ID=sb
PAYPAL_CLIENT_SECRET=sandbox_secret_placeholder
